<?xml version="1.0" encoding="utf-8"?>

<!--
    Leica Camera Overlay Configuration
    Optimized for Redmi 9T & POCO M3 (Snapdragon 662)
    - 4K60 disabled (not supported by hardware)
    - Ultra-wide 0.5x enabled by default
    - Parallel processing enabled by default (disable if unstable on custom ROMs)
-->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Enable Parallel Processing for Photo modes (Leica filters, watermarks, Supermoon, etc.) -->
    <!-- May cause issues on AOSP/MIUI ports; set to false if crashes or lag occur -->
    <bool name="pref_camera_parallel_process_enable_default">true</bool>

    <!-- Portrait Mode -->
    <!-- Disable Portrait Fix by default -->
    <bool name="pref_portraitfix_default">false</bool>

    <!-- Disable Experimental Portrait Fix by default -->
    <bool name="pref_experimental_portrait_default">false</bool>

    <!-- Enable Parallel Processing for Portrait Mode -->
    <bool name="pref_parallelportrait_default">true</bool>

    <!-- Enable 4K 30fps support (supported by SD662) -->
    <bool name="pref_4k_default">true</bool>

    <!-- Disable 4K 60fps (hardware does not support it) -->
    <bool name="pref_4k60_default">false</bool>

    <!-- Enable Universal Settings -->
    <bool name="use_universal_settings">true</bool>

    <!-- Enable Smart Tips -->
    <bool name="pref_camera_smart_tip_default">true</bool>

    <!-- Enable QR Code scanning -->
    <bool name="pref_scan_qrcode_default">true</bool>

    <!-- Night Mode -->
    <!-- Enable Parallel Processing for Night Mode -->
    <bool name="pref_parallelnight_default">true</bool>

    <!-- Other Features -->
    <!-- Set Documents scanner version to 2 -->
    <string name="pref_documents_default">2</string>

    <!-- Enable AI for Front Camera -->
    <bool name="pref_frontAI_default">true</bool>

    <!-- Ultra-wide lens setting -->
    <!-- 0 = Default, 1 = 0.5x, 2 = 0.6x -->
    <!-- Redmi 9T & POCO M3 use 0.5x ultrawide -->
    <string name="pref_uw_default">1</string>

</resources>
