<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="config_switch_sim_locked_tips">true</bool>
    <bool name="keyguard_charge_support_shader">true</bool>
    <bool name="status_bar_separate_data_and_voice">false</bool>
    <bool name="support_round_corner">false</bool>
    <bool name="flag_charging_ripple">true</bool>
    <bool name="force_shade_low_end_anim">false</bool>
    <bool name="shade_header_gradient_blur">true</bool>
    <bool name="shade_screenshot_blur">false</bool>
    <bool name="support_aod_linkage_anim">true</bool>
    <bool name="support_hyperos_device_controls_feature">true</bool>
    <bool name="config_extra_battery_saver_confirmation">true</bool>
    <bool name="config_volumeDialogUseBackgroundBlur">true</bool>

    <color name="dark_mode_icon_color_single_tone">#d9000000</color>
    <color name="light_mode_icon_color_single_tone">#ffffffff</color>
    <color name="tint_mode_icon_color_single_tone">#ff000000</color>
    
    <dimen name="new_round_height_bottom">100.0px</dimen>
    <dimen name="new_round_height_top">100.0px</dimen>
    <dimen name="notch_height">80.0px</dimen>
    <dimen name="notch_width">160.0px</dimen>
    <dimen name="rounded_corner_content_padding">40.0px</dimen>
    <dimen name="navigation_side_padding">55.0dip</dimen>
    <dimen name="qs_control_center_header_paddingTop">5.0dip</dimen>
    <dimen name="qs_control_land_tiles_margin_middle">20.0dip</dimen>
    
    <integer name="force_use_control_panel">0</integer>
    <integer name="panel_tracking_sample_rate">1</integer>

    <!-- Enable doze mode -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- If not zero, limits the internal screen recorder's framerate to the set value. -->
    <integer name="config_screenRecorderMaxFramerate">60</integer>

    <!-- If not empty, sets the AVC codec profile level used for the internal screen recorder.
         Possible values: 3, 3.1, 3.2, 4, 4.1, 4.2
    -->
    <string name="config_screenRecorderAVCProfileLevel" translatable="false">3.1</string>

    <!-- Tiles to auto add to Quick Settings upon first change of a given secure setting.
         The syntax is setting-name:spec. If the tile is a TileService, the spec should be specified
         as custom(package/class). Relative class name is supported. -->
    <string-array name="config_quickSettingsAutoAdd" translatable="false">
        <item>accessibility_display_inversion_enabled:inversion</item>
        <item>wind_down_first_time_setup:custom(com.google.android.apps.wellbeing/.screen.ui.GrayscaleTileService)</item>
        <item>focus_mode_first_time_setup:custom(com.google.android.apps.wellbeing/.focusmode.quicksettings.FocusModeTileService)</item>
    </string-array>
</resources>
